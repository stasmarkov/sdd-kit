{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stack.json",
  "description": "Stack manifest: one entry object, or an array of 1 to 8 entries with unique keys. The single hand-edited source of stack data for the workflow registry.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "name",
        "order",
        "role",
        "detect",
        "agent",
        "conventions",
        "gates",
        "debugPatterns",
        "acceptance"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$"
        },
        "order": {
          "type": "integer"
        },
        "role": {
          "type": "string",
          "enum": [
            "backend",
            "frontend",
            "fullstack",
            "mobile"
          ]
        },
        "detect": {
          "type": "string"
        },
        "agent": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "plugin": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        },
        "conventions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "skipWhenScaffolded": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "format",
                  "lint",
                  "types",
                  "test",
                  "e2e",
                  "build",
                  "other"
                ]
              },
              "unless": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requires": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_./-]+$"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_./-]+$"
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_./-]+$"
                          }
                        }
                      ]
                    }
                  }
                ],
                "description": "A path, or a list of requirements. Every list entry is required; an entry that is itself a list is met when at least one of its paths exists."
              },
              "lintFix": {
                "type": "object",
                "required": [
                  "flag",
                  "fallback"
                ],
                "additionalProperties": false,
                "properties": {
                  "flag": {
                    "type": "string",
                    "pattern": "^-[A-Za-z0-9=_-]+$"
                  },
                  "fallback": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9 _<>./@:=-]+$"
                  }
                }
              },
              "scriptFallback": {
                "type": "object",
                "required": [
                  "dependency",
                  "manifest",
                  "minMajor",
                  "contains",
                  "fallback"
                ],
                "additionalProperties": false,
                "properties": {
                  "dependency": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9@_./-]+$"
                  },
                  "manifest": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
                  },
                  "minMajor": {
                    "type": "integer"
                  },
                  "contains": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9 _./:=-]+$"
                  },
                  "fallback": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9 _<>./@:=-]+$"
                  }
                }
              }
            }
          }
        },
        "debugPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "devUrl": {
          "type": "string"
        },
        "visual": {
          "type": "string"
        },
        "buildGateGuard": {
          "type": "string"
        },
        "execWrapper": {
          "type": "object",
          "required": [
            "when",
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "when": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*$"
            },
            "command": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+( [A-Za-z0-9._-]+)*$"
            },
            "requiresRunning": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+( [A-Za-z0-9._-]+)*$"
                },
                {
                  "type": "object",
                  "required": [
                    "command",
                    "jsonField",
                    "equals"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "command": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._-]+( [A-Za-z0-9._-]+)*$"
                    },
                    "jsonField": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
                    },
                    "equals": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "devUrlFields": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
                      },
                      "description": "Dotted paths in the running check's JSON output that hold the environment's URLs (a URL or a list of URLs). When the check passes, the hostnames there count as dev URL hosts for that repo only, except those whose last label is a public TLD. Only with the object form; for example [\"raw.primary_url\", \"raw.urls\"]."
                    }
                  }
                }
              ]
            },
            "workdir": {
              "type": "object",
              "required": [
                "flag",
                "root"
              ],
              "additionalProperties": false,
              "properties": {
                "flag": {
                  "type": "string",
                  "pattern": "^-{1,2}[A-Za-z][A-Za-z0-9-]*$"
                },
                "root": {
                  "type": "string",
                  "pattern": "^(/(?!\\.{1,2}(/|$))[A-Za-z0-9._-]+)+$"
                }
              },
              "description": "For a repo below the directory that holds the marker: the wrapper's working-directory flag and the container path of that directory. The gates then run as `<command> <flag> <root>/<dir> <gate command>`, where dir is the repo's path relative to the marker's directory, and container paths under <root> in gate output are reported relative to the repo. The flag must be valid directly after `command`, so a wrapper whose command ends in an argument such as a service name cannot declare it."
            }
          },
          "description": "Run this stack's gates through a wrapper (for example a container exec) when the marker file `when` exists in the repo (or, with `workdir`, in a directory above it): each gate runs as `<command> <gate command>`. `requiresRunning` is a command whose success shows the wrapper is up; when it fails the wrapped gates are skipped."
        },
        "contractSync": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "routeListCommand": {
              "type": "string"
            },
            "consumer": {
              "type": "boolean",
              "enum": [
                true
              ]
            },
            "template": {
              "type": "string"
            }
          }
        },
