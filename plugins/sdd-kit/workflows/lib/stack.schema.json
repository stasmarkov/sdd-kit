        "gateTemplates": {
          "type": "array",
          "description": "Core other manifest only: commands a repo of an unrecognized stack may run as gates. Each command holds {script}, which the workflows fill with a script or target name Detect found in the evidence file.",
          "items": {
            "type": "object",
            "required": [
              "evidence",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "evidence": {
                "type": "string",
                "description": "File, relative to the repo root, that defines the script or target."
              },
              "command": {
                "type": "string",
                "pattern": "\\{script\\}"
              }
            }
          }
        },
        "devUrlHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
          },
          "description": "First-party manifests only: hostname suffixes whose subdomains are accepted as dev URLs, next to localhost and test."
        },
        "extends": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "description": "Overlay manifests only: the first-party stack this overlay refines."
