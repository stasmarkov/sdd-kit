{
  "$schema": "../sdd-kit/workflows/lib/stack.schema.json",
  "name": "drupal",
  "order": 20,
  "role": "backend",
  "devUrlHosts": [
    "ddev.site"
  ],
  "detect": "composer.json requiring drupal/core (often web/index.php or docroot/index.php)",
  "agent": {
    "name": "drupal-backend-dev",
    "plugin": "sdd-kit-drupal"
  },
  "conventions": [
    "module structure",
    "services + dependency injection",
    "plugins",
    "hooks",
    "config schema"
  ],
  "gates": [
    {
      "name": "PHPCS",
      "command": "./vendor/bin/phpcs --standard=Drupal,DrupalPractice --extensions=php,module,inc,install,test,profile,theme,info,yml web/modules/custom",
      "kind": "lint",
      "requires": [
        "vendor/drupal/coder",
        "vendor/squizlabs/php_codesniffer/CodeSniffer.conf",
        "web/modules/custom"
      ],
      "unless": [
        "phpcs.xml",
        "phpcs.xml.dist",
        ".phpcs.xml",
        ".phpcs.xml.dist"
      ]
    },
    {
      "name": "PHPCS (docroot)",
      "command": "./vendor/bin/phpcs --standard=Drupal,DrupalPractice --extensions=php,module,inc,install,test,profile,theme,info,yml docroot/modules/custom",
      "kind": "lint",
      "requires": [
        "vendor/drupal/coder",
        "vendor/squizlabs/php_codesniffer/CodeSniffer.conf",
        "docroot/modules/custom"
      ],
      "unless": [
        "phpcs.xml",
        "phpcs.xml.dist",
        ".phpcs.xml",
        ".phpcs.xml.dist",
        "web/core/lib/Drupal.php"
      ]
    },
    {
      "name": "PHPCS (project ruleset)",
      "command": "./vendor/bin/phpcs",
      "kind": "lint",
      "requires": [
        [
          "phpcs.xml",
          "phpcs.xml.dist",
          ".phpcs.xml",
          ".phpcs.xml.dist"
        ],
        "vendor/bin/phpcs"
      ]
    },
    {
      "name": "PHPStan",
      "command": "./vendor/bin/phpstan analyse --no-progress",
      "kind": "types",
      "requires": [
        [
          "phpstan.neon",
          "phpstan.neon.dist",
          "phpstan.dist.neon"
        ],
        "vendor/bin/phpstan"
      ]
    },
    {
      "name": "Twig CS Fixer",
      "command": "./vendor/bin/twig-cs-fixer lint --no-cache",
      "kind": "lint",
      "requires": [
        [
          ".twig-cs-fixer.php",
          ".twig-cs-fixer.dist.php"
        ],
        "vendor/bin/twig-cs-fixer"
      ]
    },
    {
      "name": "PHPUnit",
      "command": "./vendor/bin/phpunit -c web/core --fail-on-empty-test-suite web/modules/custom",
      "kind": "test",
      "requires": [
        "vendor/bin/phpunit",
        "web/core/phpunit.xml.dist",
        "web/modules/custom"
      ],
      "unless": [
        "phpunit.xml",
        "phpunit.xml.dist"
      ]
    },
    {
      "name": "PHPUnit (docroot)",
      "command": "./vendor/bin/phpunit -c docroot/core --fail-on-empty-test-suite docroot/modules/custom",
      "kind": "test",
      "requires": [
        "vendor/bin/phpunit",
        "docroot/core/phpunit.xml.dist",
        "docroot/modules/custom"
      ],
      "unless": [
        "phpunit.xml",
        "phpunit.xml.dist",
        "web/core/lib/Drupal.php"
      ]
    },
    {
      "name": "PHPUnit (project config)",
      "command": "./vendor/bin/phpunit --fail-on-empty-test-suite",
      "kind": "test",
      "requires": [
        [
          "phpunit.xml",
          "phpunit.xml.dist"
        ],
        "vendor/bin/phpunit"
      ]
    },
    {
      "name": "composer audit",
      "command": "composer audit",
      "kind": "security",
      "requires": "composer.lock"
    }
  ],
  "audit": [
    {
      "name": "composer audit",
      "command": "composer audit --locked --format=json"
    }
  ],
  "debugPatterns": [
    "dd(",
    "dump(",
    "kint(",
    "var_dump("
  ],
  "sourceDirs": [
    "web/modules/custom/",
    "web/themes/custom/",
    "docroot/modules/custom/",
    "docroot/themes/custom/",
    "modules/"
  ],
  "explore": [
    {
      "what": "Routes",
      "where": "**/*.routing.yml"
    },
    {
      "what": "Controllers",
      "where": "**/src/Controller/**/*.php"
    },
    {
      "what": "Forms and validation",
      "where": "**/src/Form/**/*.php"
    },
    {
      "what": "Services",
      "where": "**/*.services.yml, **/src/**/*.php"
    },
    {
      "what": "Hooks",
      "where": "**/*.module, **/*.install, **/src/Hook/**/*.php"
    },
    {
      "what": "Permissions and access",
      "where": "**/*.permissions.yml, **/src/Access/**/*.php"
    },
    {
      "what": "Configuration",
      "where": "**/config/schema/*.yml, config/sync/*.yml"
    },
    {
      "what": "Entities",
      "where": "**/src/Entity/**/*.php"
    },
    {
      "what": "Plugins",
      "where": "**/src/Plugin/**/*.php"
    },
    {
      "what": "Views",
      "where": "config/sync/views.view.*.yml"
    },
    {
      "what": "Blocks",
      "where": "config/sync/block.block.*.yml"
    },
    {
      "what": "Event subscribers",
      "where": "**/src/EventSubscriber/**/*.php"
    },
    {
      "what": "Kernel and functional tests",
      "where": "**/tests/src/Kernel/, **/tests/src/Functional/"
    }
  ],
  "testIntegrity": {
    "testPaths": [
      "(^|/)tests/"
    ],
    "skipMarkers": [
      "markTestSkipped(",
      "markTestIncomplete("
    ]
  },
  "security": {
    "skills": [
      "api-security",
      "drupal-11"
    ],
    "riskPaths": [
      "\\.(routing|permissions)\\.yml$",
      "(^|/)src/(Access|Controller|Form)/",
      "(^|/)composer\\.(json|lock)$",
      "(^|/)settings(\\.[a-z]+)?\\.php$"
    ]
  },
  "acceptance": "exercise the routes/controllers over HTTP",
  "execWrapper": {
    "when": ".ddev/config.yaml",
    "command": "ddev exec",
    "requiresRunning": {
      "command": "ddev describe -j",
      "jsonField": "raw.status",
      "equals": "running",
      "devUrlFields": [
        "raw.primary_url",
        "raw.urls"
      ]
    },
    "workdir": {
      "flag": "--dir",
      "root": "/var/www/html"
    }
  },
  "skills": {
    "conventions": [
      "drupal-11"
    ]
  },
  "markers": [
    "core/lib/Drupal.php",
    "web/core/lib/Drupal.php",
    "docroot/core/lib/Drupal.php"
  ],
  "packages": {
    "composer": [
      "drupal/core",
      "drupal/core-recommended"
    ]
  },
  "migrations": {
    "status": "./vendor/bin/drush updatedb:status",
    "run": "./vendor/bin/drush updatedb -y"
  },
  "docImpact": {
    "endpoint": [
      "\\.routing\\.yml$"
    ],
    "schema": [
      "\\.install$",
      "(^|/)config/schema/"
    ],
    "config": [
      "(^|/)config/(sync|install|optional)/",
      "\\.settings\\.php$"
    ]
  }
}
