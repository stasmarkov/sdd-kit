{
  "mcpServers": {
    "sdd-kit": {
      "command": "node",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/runtime/bridge/server.mjs",
        "--host",
        "cursor"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated"
      ]
    }
  }
}
