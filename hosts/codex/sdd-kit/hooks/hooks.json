{
  "description": "SDD Kit lifecycle hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" SessionStart --host codex --hook session-start.sh"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" SessionStart --host codex --hook stack-hint.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" SessionStart --host codex --hook post-compact-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PreToolUse --host codex --hook block-dangerous.sh"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PreToolUse --host codex --hook check-commit-msg.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PreToolUse --host codex --hook token-budget.sh"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PreToolUse --host codex --hook drupal-test-first.sh"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PreToolUse --host codex --hook laravel-test-first.sh"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PreToolUse --host codex --hook nextjs-test-first.sh"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PreToolUse --host codex --hook block-dangerous.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" UserPromptSubmit --host codex --hook prompt-preflight.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PostToolUse --host codex --hook scan-secrets.sh"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PostToolUse --host codex --hook gate-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PostToolUse --host codex --hook drupal-lint.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PostToolUse --host codex --hook laravel-lint.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PostToolUse --host codex --hook nextjs-lint.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PostToolUse --host codex --hook scan-injection.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" SessionEnd --host codex --hook session-end.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" Stop --host codex --hook lesson-nudge.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/runtime/hooks/dispatch.mjs\" PreCompact --host codex --hook pre-compact-save.sh"
          }
        ]
      }
    ]
  }
}
